<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Inherit the analytic account form view to add a required attribute to the code field -->
        <record id="view_purchase_order_filter_inherit" model="ir.ui.view">
            <field name="name">view.purchase.order.filter.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <!-- Insertar el nuevo campo acc_analytic_id -->
                <xpath expr="//search" position="inside">
                    <field name="acc_analytic_id" string="Analytic Account"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_view_search_inherit" model="ir.ui.view">
            <field name="name">purchase.order.view.search.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
            <field name="arch" type="xml">
                <!-- Insertar el nuevo campo acc_analytic_id -->
                <xpath expr="//search" position="inside">
                    <field name="acc_analytic_id" string="Analytic Account"/>
                </xpath>
            </field>
        </record>
        
        <record id="purchase_order_form_inherit_int" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.int</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_analytic_global.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_analytic_id']" position="after">
                    <button name="action_set_analytic_account" type="object" states="draft,sent,to approve"
                            string="Set analytic to all lines"
                            class="btn btn-default btn-sm o_icon_button oe_edit_only"
                            help="This changes the analytic account of all lines to the given analytic account"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
